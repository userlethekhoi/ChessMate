{
  "manifest_version": 3,
  "name": "ChessMate Agent",
  "version": "0.1.0",
  "update_url": "https://raw.githubusercontent.com/userlethekhoi/Extension-Chess.Com/main/updates.xml",
  "description": "Event-driven chess analysis assistant for practice and bot games.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "ChessMate Agent",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.js-loader-DcmXcLcj.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chess.com/*",
        "https://www.chess.com/*"
      ],
      "resources": [
        "src/engine/*",
        "assets/stockfish-DDdgjDOu.js",
        "assets/config-manager-B2LfQHYM.js",
        "assets/thinking-modes-MlZlJpKT.js",
        "assets/engine-manager-C_sYJ1ET.js",
        "assets/content.js-CRW1zmAY.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {}
}
